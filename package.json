{
  "name": "preview-feedback",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Honor-system feedback for private website previews: pins, threads and resolve, no accounts, no extension.",
  "scripts": {
    "build": "pnpm --filter @preview-feedback/widget build",
    "dev": "pnpm build && pnpm --filter @preview-feedback/api dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm build && pnpm --filter @preview-feedback/widget e2e",
    "feedback": "pnpm --filter @preview-feedback/api cli"
  }
}
