---
import Feedback from "../components/Feedback.astro";
import { nav } from "../site";
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <title>{title} · Acme</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">Acme</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={n.href.replace(/\/$/, "") === path.replace(/\/$/, "") || n.href === path ? "page" : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site"><p>© Acme Anvils, Inc. A demo site for trying the feedback widget. Not a real company.</p></footer>
    <Feedback />
  </body>
</html>
<style is:global>
  :root { --accent: #d6431f; --ink: #1d232b; --muted: #5b6672; --band: #f5f1ea; --bg: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: var(--bg); font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
  header.site { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 24px; border-bottom: 1px solid #e6e1d8; flex-wrap: wrap; }
  .brand { font-weight: 800; font-size: 1.3rem; color: var(--accent); text-decoration: none; letter-spacing: -0.02em; }
  header nav { display: flex; gap: 18px; flex-wrap: wrap; }
  header nav a { color: var(--ink); text-decoration: none; padding: 4px 0; border-bottom: 2px solid transparent; }
  header nav a[aria-current] { border-bottom-color: var(--accent); font-weight: 600; }
  main > section { padding: 64px 24px; }
  main > section:nth-child(even) { background: var(--band); }
  .wrap { max-width: 920px; margin: 0 auto; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; margin: 0 0 16px; letter-spacing: -0.02em; }
  h2 { font-size: 1.7rem; margin: 0 0 12px; }
  p.lede { font-size: 1.2rem; color: var(--muted); max-width: 40em; }
  .btn { display: inline-block; background: var(--accent); color: #fff; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: 600; }
  .btn.ghost { background: transparent; color: var(--accent); border: 2px solid var(--accent); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 24px; }
  .card { background: #fff; border: 1px solid #e6e1d8; border-radius: 12px; padding: 22px; }
  .card h3 { margin: 0 0 6px; }
  .price { font-size: 2.2rem; font-weight: 800; }
  .price small { font-size: 1rem; font-weight: 400; color: var(--muted); }
  ul.ticks { padding-left: 1.2em; } ul.ticks li { margin: 4px 0; }
  details { background: #fff; border: 1px solid #e6e1d8; border-radius: 10px; padding: 12px 16px; margin: 10px 0; }
  summary { cursor: pointer; font-weight: 600; }
  form label { display: block; margin: 14px 0 4px; font-weight: 600; }
  form input, form textarea { width: 100%; font: inherit; padding: 10px; border: 1px solid #c9c2b6; border-radius: 8px; }
  footer.site { padding: 28px 24px; color: var(--muted); font-size: 0.9rem; border-top: 1px solid #e6e1d8; }
</style>
