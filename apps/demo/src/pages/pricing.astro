---
import Page from "../layouts/Page.astro";
---
<Page title="Pricing" description="Three anvils, three prices, no surprises.">
  <section data-section="pricing-hero"><div class="wrap">
    <h1>Simple pricing</h1>
    <p class="lede">Pick a weight. Shipping is included on every plan.</p>
  </div></section>
  <section data-section="plans"><div class="wrap">
    <div class="cards">
      <div class="card"><h3>Hobby</h3><p class="price">$99 <small>/ anvil</small></p><ul class="ticks"><li>50 lb</li><li>Standard shipping</li><li>30-day returns</li></ul></div>
      <div class="card"><h3>Pro</h3><p class="price">$249 <small>/ anvil</small></p><ul class="ticks"><li>150 lb</li><li>Next-day shipping</li><li>Free horn polish</li></ul></div>
      <div class="card"><h3>Studio</h3><p class="price">$599 <small>/ anvil</small></p><ul class="ticks"><li>300 lb</li><li>Crane delivery</li><li>Lifetime guarantee</li></ul></div>
    </div>
  </div></section>
  <section data-section="faq"><div class="wrap">
    <h2>Questions</h2>
    <details><summary>Do you ship outside the US?</summary><p>Not yet. Customs does not like falling objects.</p></details>
    <details><summary>Can I return a used anvil?</summary><p>Within 30 days, if it is still shaped like an anvil.</p></details>
    <details><summary>Is there a bulk discount?</summary><p>Ask us about orders of ten or more.</p></details>
  </div></section>
</Page>
