---
import Page from "../layouts/Page.astro";
---
<Page title="Anvils, delivered" description="Acme makes anvils for people who need one by Tuesday.">
  <section data-section="hero"><div class="wrap">
    <h1>The anvil you need, on your doorstep by Tuesday.</h1>
    <p class="lede">Acme Anvils forges, ships and guarantees heavy things. Cartoon coyotes welcome.</p>
    <p><a class="btn" href="/pricing">See pricing</a> <a class="btn ghost" href="/contact">Talk to us</a></p>
  </div></section>
  <section data-section="features"><div class="wrap">
    <h2>Why Acme</h2>
    <div class="cards">
      <div class="card"><h3>Forged, not cast</h3><p>Every anvil is hammered from a single billet of tool steel.</p></div>
      <div class="card"><h3>Ships in a day</h3><p>Order before noon and it is on a truck by dinner.</p></div>
      <div class="card"><h3>Money-back guarantee</h3><p>If it does not fall on the right person, send it back.</p></div>
    </div>
  </div></section>
  <section data-section="testimonials"><div class="wrap">
    <h2>Loved by people in a hurry</h2>
    <p class="lede">“I dropped it on my first try.” — W. E. Coyote, Arizona</p>
  </div></section>
  <section data-section="cta"><div class="wrap">
    <h2>Ready to order?</h2>
    <p><a class="btn" href="/contact">Get a quote</a></p>
  </div></section>
</Page>
